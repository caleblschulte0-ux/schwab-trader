# Copy to .env for LOCAL runs (gitignored). For GitHub Actions these are repo Secrets/Variables.

# === Alpaca (required) — https://app.alpaca.markets → API Keys. Static; never expires. ===
ALPACA_API_KEY=your_key_id
ALPACA_SECRET_KEY=your_secret

# === Behavior (repo VARIABLES in CI) ===
# DRY_RUN=true            # paper account (default). false = LIVE account + live keys.
# MAX_CAPITAL=1000        # cap on the dollars the bot manages (default: whole account)
# MAX_DRAWDOWN_HALT=0.20  # kill switch vs high-water mark
# TRADE_WINDOW_MIN=120    # only trade this close to the close
# NO_TRADE=true           # compute + report, submit nothing
# FORCE_RUN=true          # ignore market-hours guard (orders queue for the open)

# === Optional: weekly Claude analyst note (analyst.yml). Not needed to trade. ===
# CLAUDE_CODE_OAUTH_TOKEN=...
