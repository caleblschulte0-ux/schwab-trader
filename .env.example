# Copy this file to ".env" and fill in your real values.
# The real ".env" file is gitignored and must never be committed.

# From your app in the Schwab Developer Portal (https://developer.schwab.com)
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Must EXACTLY match the callback URL registered for your app,
# including any trailing slash (Schwab compares this character-for-character).
SCHWAB_CALLBACK_URL=https://127.0.0.1/

# Where the OAuth tokens are cached on disk (gitignored).
SCHWAB_TOKEN_PATH=token.json
