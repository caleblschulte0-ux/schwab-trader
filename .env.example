# Copy this file to ".env" and fill in your real values.
# The real ".env" file is gitignored and must never be committed.
#
# For the AUTOMATED bot (GitHub Actions), these go in repo Settings -> Secrets and
# variables -> Actions as SECRETS instead of a .env file. See SETUP.md.

# === Schwab (required) — from your app in the Schwab Developer Portal ===
# https://developer.schwab.com
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
# Must EXACTLY match the callback URL registered for your app, trailing slash included.
SCHWAB_CALLBACK_URL=https://127.0.0.1/
# Where OAuth tokens are cached on disk for the local scripts (gitignored).
SCHWAB_TOKEN_PATH=token.json
# The automated bot uses this instead of token.json (set it as a repo SECRET):
# SCHWAB_REFRESH_TOKEN=...   # produced by `python auth_setup.py`, expires ~7 days

# === Market data (optional but recommended) — the brain's funnel degrades without them ===
FMP_API_KEY=your_fmp_key_here          # https://financialmodelingprep.com (free tier)
ALPHA_API_KEY=your_alphavantage_key    # https://www.alphavantage.co (free tier, 25 calls/day)

# === The brain (required for automated picks) — a Claude subscription OAuth token ===
# CLAUDE_CODE_OAUTH_TOKEN=...           # set as a repo SECRET; powers .github/workflows/brain.yml

# === Behavior switches (set as repo VARIABLES, not secrets) ===
# DRY_RUN=true                          # PAPER mode (default). Set to false to place REAL orders.
# OPTIONS_LIVE=false                    # keep puts paper-only even after DRY_RUN=false

# === Misc ===
# SEC_CONTACT_EMAIL=you@example.com     # identifies you to SEC EDGAR (8-K feed); optional
